{
  "name": "pqdif",
  "version": "0.1.1",
  "description": "Node.js and browser readers for PQDIF and COMTRADE power-quality recordings",
  "keywords": [
    "pqdif",
    "pqd",
    "comtrade",
    "power-quality",
    "power-quality-data-interchange-format",
    "electrical-measurements",
    "waveform",
    "rms",
    "binary-parser",
    "parser",
    "json",
    "nodejs",
    "browser"
  ],
  "type": "commonjs",
  "main": "./lib/pqdif.js",
  "exports": {
    ".": {
      "types": "./lib/pqdif.d.ts",
      "import": "./lib/pqdif.mjs",
      "require": "./lib/pqdif.js"
    },
    "./browser": "./lib/pqdif.js",
    "./comtrade": {
      "types": "./lib/comtrade.d.ts",
      "import": "./lib/comtrade.mjs",
      "require": "./lib/comtrade.js"
    },
    "./comtrade/browser": "./lib/comtrade.js"
  },
  "files": [
    "lib/",
    "pqdif.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test pqdif.test.cjs",
    "parse": "node pqdif.cjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "module": "./lib/pqdif.mjs",
  "types": "./lib/pqdif.d.ts",
  "bin": {
    "pqdif-to-json": "pqdif.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
